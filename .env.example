# Model provider: anthropic (default) or openai
SENGOL_MODEL_PROVIDER=anthropic

# Anthropic API key — required by `make live` (the agent generates a real
# answer) and by the LLM-judge evaluators in `make pre-deploy-check` / CI,
# regardless of SENGOL_MODEL_PROVIDER. `make demo` / `make seed` replay
# pre-recorded traces and need no key. The compliance eval suite always
# judges via Anthropic (see controlbook.yaml).
ANTHROPIC_API_KEY=

# OpenAI API key (used when SENGOL_MODEL_PROVIDER=openai for agent inference)
OPENAI_API_KEY=

# Sengol API server URL — matches the sengol-api service in docker-compose.yml
SENGOL_API_URL=http://sengol-api:8080

# Bearer token for SDK → API server auth
# Must match SENGOL_API_TOKEN set in the sengol-api service environment
SENGOL_API_TOKEN=dev-token-change-in-production

# Tenant ID (any string; namespaces audit records)
SENGOL_TENANT_ID=acme-bank-ca

# Audit store mode — always the API (ApiAuditSink); records are sent to
# SENGOL_API_URL / signed with the server, never written in-process.
SENGOL_AUDIT_URI=api-server

# Enables PDF report generation (development only)
SENGOL_ENVIRONMENT=development

# Drift alerts fire here (alert_only). Slack incoming-webhook or webhook.site URL.
SENGOL_DRIFT_WEBHOOK=
